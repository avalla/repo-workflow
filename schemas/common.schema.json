{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-workflow.invalid/schemas/common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\x00-\\x1f])[^/]+(?:/[^/]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "scope"
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/path"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "tasks": {
          "type": "array",
          "items": {
            "enum": [
              "feature",
              "bugfix",
              "docs",
              "research",
              "release"
            ]
          },
          "uniqueItems": true,
          "minItems": 0
        }
      },
      "required": [
        "components",
        "paths",
        "tasks"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "applicability": {
          "$ref": "common.schema.json#/$defs/applicability"
        },
        "binding": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "procedure": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "category",
        "required",
        "applicability",
        "binding",
        "environment",
        "resources",
        "procedure"
      ],
      "not": {
        "properties": {
          "binding": {
            "type": "string"
          },
          "procedure": {
            "type": "string"
          }
        },
        "required": [
          "binding",
          "procedure"
        ]
      }
    }
  }
}
