+
+test.each(["/a/..//evil.example", "/%2e%2e//evil.example", "/a/..///evil.example"])(
+  "normalized next %p cannot become a network-path redirect",
+  (input) => {
+    const next = safeNext(input, "/orgs");
+    expect(next).toBe("/orgs");
+    expect(new URL(next, "https://manager.example").origin).toBe("https://manager.example");
+  },
+);
+
+test("preserves same-origin normalized routes, queries and fragments", () => {
+  expect(safeNext("/a/../orders?next=//example.test#top")).toBe("/orders?next=//example.test#top");
+});
