{
  "schemaVersion": 1,
  "framework": {
    "version": "0.1.0"
  },
  "project": {
    "name": "library-cli",
    "domain": "business-application",
    "delivery": [
      "packaged"
    ],
    "layout": "single-package",
    "documentationLanguage": "en",
    "codeLanguage": "en"
  },
  "harnesses": [
    "generic",
    "codex",
    "claude-code"
  ],
  "components": {
    "main": {
      "path": "src",
      "surface": "cli",
      "stack": [
        "python"
      ],
      "profiles": [
        {
          "id": "surface-library-cli",
          "version": "0.1.0",
          "scope": "component:main"
        }
      ],
      "settings": {}
    }
  },
  "profiles": [],
  "capabilities": [],
  "integrations": {
    "tracker": null,
    "ci": null
  },
  "workflow": {
    "feature": "reviewed-slice",
    "bugfix": "reproduce-fix-verify",
    "docs": "documentation-change",
    "research": "investigation",
    "release": "release-readiness"
  },
  "review": {
    "independent": "required",
    "external": {
      "provider": null,
      "policy": "disabled"
    }
  },
  "state": {
    "current": "docs/STATUS.md",
    "roadmap": "ROADMAP.md",
    "decisions": "docs/adr",
    "evidence": "docs/sessions",
    "map": "REPO_GRAPH.md"
  },
  "context": {
    "statusTargetBytes": 8000,
    "statusWarningBytes": 10000,
    "skillLoading": "on-demand"
  },
  "commands": {
    "synthetic-check": {
      "argv": [
        "python3",
        "-c",
        "raise SystemExit('must not execute during contract validation')"
      ],
      "cwd": ".",
      "affectedPaths": [
        "src"
      ],
      "environment": "local",
      "effects": [
        "read"
      ],
      "authorization": "task-scope"
    }
  },
  "environments": {
    "local": {
      "requirements": [
        "adoption must confirm real scripts and prerequisites"
      ],
      "remote": false
    }
  },
  "gates": [
    {
      "id": "synthetic",
      "category": "fixture",
      "required": false,
      "applicability": {
        "components": [
          "main"
        ],
        "paths": [
          "src"
        ],
        "tasks": [
          "feature"
        ]
      },
      "binding": "synthetic-check",
      "environment": "local",
      "resources": [],
      "procedure": null
    }
  ],
  "overrides": [],
  "approvals": [
    {
      "id": "publish",
      "scope": "project",
      "applicability": {
        "components": [],
        "paths": [],
        "tasks": [
          "release"
        ]
      },
      "policy": "required",
      "authority": "project owner"
    }
  ],
  "presets": [],
  "localProfiles": []
}
